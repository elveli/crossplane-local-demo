# Pinned versions — single source of truth. Sourced by the Makefile and scripts/.
# Verified 2026-11-20 against GitHub releases (latest non-prerelease) and the
# Crossplane Helm repo; every package tag below was confirmed to publish a
# linux/amd64 image on xpkg.crossplane.io.

# Crossplane core (Helm chart crossplane-stable/crossplane; chart version == app version)
CROSSPLANE_VERSION=2.4.3

# Crossplane v2 has no default package registry: package refs must be fully qualified.
XPKG_REGISTRY=xpkg.crossplane.io

# Providers
PROVIDER_KUBERNETES_VERSION=v1.4.1
PROVIDER_HELM_VERSION=v1.5.0

# Functions
FUNCTION_PATCH_AND_TRANSFORM_VERSION=v0.11.2
FUNCTION_GO_TEMPLATING_VERSION=v0.13.2
FUNCTION_AUTO_READY_VERSION=v0.7.3

# CloudNativePG (Postgres for Apps with database.enabled; see cluster/cnpg-values.yaml)
CNPG_OPERATOR_CHART_VERSION=0.29.2
CNPG_OPERATOR_VERSION=1.30.2
CNPG_CLUSTER_CHART_VERSION=0.9.0
POSTGRES_IMAGE=ghcr.io/cloudnative-pg/postgresql:18.7-minimal-trixie

# Demo app image (examples/). nginxdemos/hello:plain-text answers curl with
# plain text (server name/address/date) -- nicer in a terminal than HTML.
APP_IMAGE=nginxdemos/hello:plain-text

# Phase 6 (optional, `make aws`): LocalStack + provider-upjet-aws family members.
# Family members (provider-aws-s3, -dynamodb) declare a dependency on
# provider-family-aws ">= 0.0.0"; we install the family explicitly at the same
# tag so the dependency is satisfied by a pinned version.
PROVIDER_AWS_VERSION=v2.10.0
# 4.14.0 is the LAST LocalStack release that starts without an account: from
# the 2026.03 CalVer releases on, the image exits (code 55) unless
# LOCALSTACK_AUTH_TOKEN is set. Verified 2026-11-20 -- see README "Phase 6".
LOCALSTACK_IMAGE=localstack/localstack:4.14.0

# kind fallback cluster
KIND_CLUSTER_NAME=crossplane-demo
